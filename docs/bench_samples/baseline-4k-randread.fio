[global]
; NOTE: fio on Windows fails with non-ASCII paths (err=2 filesetup.c open).
; Keep filename and job file path pure ASCII.
ioengine=windowsaio
direct=1
rw=randread
bs=4k
iodepth=16
numjobs=1
thread=1
time_based=1
runtime=10
ramp_time=1
size=1g
filename=bench_testfile.dat
group_reporting=1
invalidate=1
norandommap=1
unlink=1

[random-read-4k-qd16]
