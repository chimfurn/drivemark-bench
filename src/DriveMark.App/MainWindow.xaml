<Window x:Class="DriveMark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:DriveMark.Chart;assembly=DriveMark.Chart"
        Title="DriveMark — 硬盘测速"
        Width="1400" Height="880" MinWidth="980" MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA"
        FontFamily="Microsoft YaHei" FontSize="12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部：数据来源与图表选项 ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="14,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="数据来源" VerticalAlignment="Center" Foreground="#6B7280"/>
                <ComboBox x:Name="DatasetCombo" Width="230" Margin="6,0,6,0" VerticalAlignment="Center"/>
                <Button x:Name="OpenLogsButton" Content="打开日志目录…" Padding="10,3" VerticalAlignment="Center"/>

                <TextBlock Text="横轴" VerticalAlignment="Center" Foreground="#6B7280" Margin="16,0,0,0"/>
                <ComboBox x:Name="XAxisCombo" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Text="纵轴" VerticalAlignment="Center" Foreground="#6B7280" Margin="12,0,0,0"/>
                <ComboBox x:Name="YAxisCombo" Width="170" Margin="6,0,0,0" VerticalAlignment="Center"/>


                <TextBlock Text="绘图方式" VerticalAlignment="Center" Foreground="#6B7280" Margin="12,0,0,0"/>
                <ComboBox x:Name="PlotModeCombo" Width="118" Margin="6,0,0,0" VerticalAlignment="Center"
                          ToolTip="实时绘图：边测边画（不生成图片文件）；完成后绘图：测试结束后用日志出图"/>

                <Button x:Name="ExportPngButton" Content="导出图片…" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="AboutButton" Content="关于" Padding="10,3" Margin="8,0,0,0"
                        VerticalAlignment="Center" ToolTip="关于 DriveMark / 基于开源 fio 开发"/>
            </WrapPanel>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="340"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：简单设置 + 其他设置 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- 简单设置 -->
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <StackPanel>
                            <TextBlock Text="选择测试" FontWeight="SemiBold" FontSize="14"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="测试项目" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleProfileCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,7"
                                          ToolTip="选择测试类型（随机读不写盘）"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="块大小" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleBlockSizeCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,7"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="默认 4 KB。可选预设，也可自己输入：4k、8192、1m"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="文件大小" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleSizeCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,7"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="可选预设，也可自己输入：512m、4g；纯数字按 MB 计算（512 = 512 MB）"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="测试时长" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleDurationCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,7"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="可选预设，也可自己输入秒数：1800（= 1800 秒）、30m、1h"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="采样间隔" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleSamplingCombo" Grid.Row="4" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="默认 10 毫秒（约每秒 100 次）。可输入：10、50ms、1s"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="队列深度" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleQueueDepthCombo" Grid.Row="5" Grid.Column="1" Margin="0,0,0,7"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="iodepth：同时发给硬盘的并发请求数。随机读/写常用 32，顺序读/写常用 8；也可自己输入 1~1024"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="队列数" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SimpleJobCountCombo" Grid.Row="6" Grid.Column="1"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          ToolTip="numjobs：同时运行的 fio 任务（队列）个数。一般用 1；可输入 1~64"/>
                            </Grid>
                            <TextBlock Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="选好上面几项，点右下角「开始测试」即可。数值项既可选预设，也可直接输入（如时长 1800 秒、大小 4g、块大小 4k、队列深度 64）。"/>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="SaveResultsCheck" Content="保存结果到 results 目录" IsChecked="True"
                                          VerticalAlignment="Center"
                                          ToolTip="开启后每次测试的 job 文件 / 结果 JSON / 日志 / 摘要会保存到软件目录下的 results\ 文件夹（可随时关闭）。"/>
                                <Button x:Name="OpenResultsButton" Content="打开结果目录" Padding="8,2" Margin="10,0,0,0"
                                        ToolTip="在资源管理器中打开 results 目录"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 其他设置（高级）：作为填充区域，展开时自动使用剩余高度 -->
                    <Expander x:Name="AdvancedExpander" Header="其他设置（高级，一般不用改）"
                              IsExpanded="False" Margin="10,4,10,10" Foreground="#374151"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                            <!-- 整个高级区统一滚动：RAW / 按钮 / 坐标轴 / fio 参数 / 日志页签都在同一个滚动条里，
                                 避免固定行把小窗口挤满，也避免 RAW 下拉框太宽被截断。 -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="8,6,8,6">
                                <StackPanel>
                                    <!-- RAW / 未格式化磁盘（默认只读） -->
                                    <Border BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="RAW / 未格式化磁盘（默认只读）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="RawDeviceCombo" HorizontalAlignment="Stretch" MinWidth="140"
                                                      Margin="0,0,0,4"
                                                      ToolTip="fio 直接读写原始设备：不创建测试文件。默认只读；整盘（PhysicalDriveN）需要管理员权限。"/>
                                            <WrapPanel>
                                                <Button x:Name="RefreshRawDevicesButton" Content="刷新" Padding="8,2" Margin="0,0,6,4"/>
                                                <Button x:Name="RawRunButton" Content="开始 RAW 测试" Padding="8,2" Margin="0,0,10,4"/>
                                                <CheckBox x:Name="RawWriteCheck" Content="允许 RAW 写入（覆盖数据）"
                                                          VerticalAlignment="Center" Margin="0,0,0,4"
                                                          ToolTip="默认只读。勾选后会把当前测试项目（如随机写）真实写入 RAW 设备——直接覆盖设备数据且无法清理，仅对确认可清空的盘使用；开始前仍会二次确认。"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="RawDeviceNote" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 操作按钮 -->
                                    <CheckBox x:Name="SmoothFioLogCheck"
                                              Content="启用 fio 日志平滑（最小 100ms 窗口，默认关闭）"
                                              Margin="0,0,0,6" VerticalAlignment="Center"
                                              ToolTip="默认关闭：带宽/IOPS 日志按所选采样间隔原样记录（大块 + 高队列时可能出现瞬时假点）。开启：fio 对带宽/IOPS 日志使用最小 100ms 窗口（延迟日志不受影响），可抑制假点。"/>
                                    <CheckBox x:Name="RealtimePluginCheck"
                                              Content="启用实时日志插件（默认开启）"
                                              IsChecked="True" Margin="0,0,0,6" VerticalAlignment="Center"
                                              ToolTip="插件会读取 fio 运行中写出的 live 采样文件，实时显示全分辨率散点；关闭后测试中退回 fio 进度采样。fio 的普通日志仍会在结束后完整生成。"/>

                                    <WrapPanel Margin="0,0,0,6">
                                        <Button x:Name="SaveJobButton" Content="保存 .fio" Padding="8,2" Margin="0,0,6,4"/>
                                        <Button x:Name="CopyJobButton" Content="复制 job" Padding="8,2" Margin="0,0,6,4"/>
                                        <Button x:Name="SaveConfigButton" Content="保存配置" Padding="8,2" Margin="0,0,6,4"/>
                                        <Button x:Name="LoadConfigButton" Content="加载配置" Padding="8,2" Margin="0,0,6,4"/>
                                        <Button x:Name="ResetParamsButton" Content="恢复默认" Padding="8,2" Margin="0,0,0,4"/>
                                    </WrapPanel>

                                    <!-- 自定义坐标轴 -->
                                    <Border BorderBrush="#E2E5EA" BorderThickness="0,0,0,1" Padding="0,2,0,8" Margin="0,0,0,4">
                                        <WrapPanel>
                                            <CheckBox x:Name="AutoXCheck" Content="横轴自动" IsChecked="True"
                                                      VerticalAlignment="Center" Margin="0,0,8,4"/>
                                            <TextBlock Text="最小" VerticalAlignment="Center"/>
                                            <TextBox x:Name="XMinBox" Width="54" Margin="4,0,8,4" IsEnabled="False"/>
                                            <TextBlock Text="最大" VerticalAlignment="Center"/>
                                            <TextBox x:Name="XMaxBox" Width="54" Margin="4,0,8,4" IsEnabled="False"/>
                                            <TextBlock Text="步长" VerticalAlignment="Center"/>
                                            <TextBox x:Name="XStepBox" Width="54" Margin="4,0,12,4" IsEnabled="False"/>

                                            <CheckBox x:Name="AutoYCheck" Content="纵轴自动" IsChecked="True"
                                                      VerticalAlignment="Center" Margin="0,0,8,4"/>
                                            <TextBlock Text="最小" VerticalAlignment="Center"/>
                                            <TextBox x:Name="YMinBox" Width="54" Margin="4,0,8,4" IsEnabled="False"/>
                                            <TextBlock Text="最大" VerticalAlignment="Center"/>
                                            <TextBox x:Name="YMaxBox" Width="54" Margin="4,0,8,4" IsEnabled="False"/>
                                            <TextBlock Text="步长" VerticalAlignment="Center"/>
                                            <TextBox x:Name="YStepBox" Width="54" Margin="4,0,0,4" IsEnabled="False"/>
                                        </WrapPanel>
                                    </Border>

                                    <StackPanel x:Name="ParamsHost"/>

                                    <TabControl Height="160" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                                        <TabItem Header="job 文件">
                                            <TextBox x:Name="JobPreview" IsReadOnly="True" AcceptsReturn="True"
                                                     FontFamily="Consolas" FontSize="11"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     BorderThickness="0" Padding="4"/>
                                        </TabItem>
                                        <TabItem x:Name="ValidationTab" Header="校验">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                                <StackPanel x:Name="ValidationHost"/>
                                            </ScrollViewer>
                                        </TabItem>
                                        <TabItem Header="命令行">
                                            <TextBox x:Name="CommandPreview" IsReadOnly="True" AcceptsReturn="True"
                                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="4"/>
                                        </TabItem>
                                        <TabItem Header="运行日志">
                                            <TextBox x:Name="RunLogText" IsReadOnly="True" AcceptsReturn="True"
                                                     FontFamily="Consolas" FontSize="11"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     BorderThickness="0" Padding="4"/>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Expander>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#EEF0F3"/>

            <!-- 右：图表 -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" CornerRadius="6" BorderBrush="#E2E5EA"
                        BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="ChartSummary" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="ChartDetail" Foreground="#6B7280" FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E5EA" BorderThickness="1">
                    <chart:ChartControl x:Name="ChartView"/>
                </Border>

                <!-- 视口控制：长时间测试可左右滑动查看 -->
                <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E2E5EA"
                        BorderThickness="1" Padding="10,4" Margin="0,8,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="FollowLatestCheck" Content="跟随最新" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="新的数据点到来时自动滚动到最新位置"/>
                            <TextBlock Text="显示范围" VerticalAlignment="Center" Foreground="#6B7280"/>
                            <ComboBox x:Name="ViewportRangeCombo" Width="92" Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip="横轴显示的时间窗口；自动=显示全部数据"/>
                        </StackPanel>
                        <Slider x:Name="ViewportSlider" Minimum="0" Maximum="1" Value="0"
                                VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="False"
                                ToolTip="左右拖动查看长时间测试的不同区段"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 测试运行控制条 ============ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="测试硬盘：" Foreground="#6B7280" VerticalAlignment="Center"/>
                    <ComboBox x:Name="TargetCombo" Width="250" Margin="4,0,4,0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshTargetsButton" Content="↻" Width="26" Padding="0" Height="24"
                            ToolTip="刷新硬盘列表" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TargetNote" Foreground="#DC2626" FontSize="11" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,10,0">
                    <CheckBox x:Name="AllowWriteCheck" Content="允许写入测试" VerticalAlignment="Center"
                              ToolTip="写测试会真实写入所选硬盘，测试数据结束后自动删除。"/>
                    <CheckBox x:Name="SystemWriteCheck" Content="允许系统盘写入" IsEnabled="False"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="默认禁止对系统盘写入。勾选后还需二次确认；程序只会在 盘符根\DriveMark-test 下创建测试文件，绝不格式化或清空磁盘。"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartTestButton" Content="▶ 开始测试" Padding="16,4" FontWeight="SemiBold"
                            Background="#2563EB" Foreground="White" BorderBrush="#1D4ED8"/>
                    <Button x:Name="StopTestButton" Content="■ 停止" Padding="12,4" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>

                <ProgressBar x:Name="RunProgressBar" Grid.Column="3" Width="170" Height="16" Margin="14,0,0,0"
                             Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>

                <TextBlock x:Name="LiveRunText" Grid.Column="4" Margin="12,0,12,0" VerticalAlignment="Center"
                           Foreground="#374151" Text="就绪"/>

                <TextBlock x:Name="LastRunText" Grid.Column="5" VerticalAlignment="Center"
                           Foreground="#059669"/>
            </Grid>
        </Border>

        <!-- ============ 底部状态栏 ============ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="语言" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    <Button x:Name="LanguageZhButton" Content="中文" Padding="7,1" Margin="4,0,0,0"
                            FontSize="11" Height="21" VerticalAlignment="Center"
                            ToolTip="切换到中文界面 / Switch to Chinese"/>
                    <Button x:Name="LanguageEnButton" Content="English" Padding="7,1" Margin="4,0,0,0"
                            FontSize="11" Height="21" VerticalAlignment="Center"
                            ToolTip="Switch to English / 切换到英文界面"/>
                </StackPanel>
                <TextBlock x:Name="FioNoticeText" DockPanel.Dock="Right" FontSize="11" Foreground="#9CA3AF"
                           Margin="12,0,0,0" Text="基于开源 fio（Flexible I/O Tester）开发"
                           ToolTip="DriveMark 是基于 fio 的图形界面；fio 源码与 GPL-2.0 许可证见软件目录 FIO\"/>
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#9CA3AF"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
